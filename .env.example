# انسخ هذا الملف باسم .env.local ولا ترفعه أبدًا إلى GitHub

# من إعدادات مشروع Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مفتاح Service Role — للاستخدام في الخادم فقط (API Routes / Server Actions)
# لا يجوز أبدًا وضعه في متغير يبدأ بـ NEXT_PUBLIC (القسم 61، بند 11)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
